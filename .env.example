# Copiar para .env (ou correr scripts/init_env.sh, que gera segredos aleatórios).
# O .env NÃO vai para o Git.

# --- PostgreSQL (instância nativa Homebrew PG14) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=sentinel
PG_USER=sentinel
PG_PASSWORD=change_me
# Utilizador só de leitura (Node-RED / dashboard)
PG_RO_USER=sentinel_ro
PG_RO_PASSWORD=change_me

# --- Pentaho Data Integration ---
PDI_HOME=$HOME/pentaho/data-integration

# --- Serviço Python (FastAPI) ---
#   /gateway/* : fonte REST simulada (sensores)
#   /ai/*      : inferência (stateless)
#   /ops/*     : orquestração de Jobs Pentaho (exige X-API-Key)
API_HOST=127.0.0.1
API_PORT=8000
OPS_API_TOKEN=change_me

# --- Ollama (nativo, aceleração Metal) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Contexto limitado de propósito: o modelo suporta 256K, mas a KV cache não cabe em 8 GB de RAM.
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=15m
# Timeout FastAPI -> Ollama. Tem de ser MENOR que o read timeout do step REST Client no Pentaho.
OLLAMA_TIMEOUT_S=150
PROMPT_VERSION=v1

# --- Correlação ---
CORRELATION_GAP_MIN=5
CORRELATION_MAX_SPAN_MIN=20

# --- Node-RED (pós-MVP) ---
NODE_RED_PORT=1880

# --- Notificações por e-mail (SMTP) ---
# Em desenvolvimento: Mailpit local (scripts/run_mailpit.sh) com autenticação; UI em http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=sentinel
SMTP_PASSWORD=change_me
MAIL_FROM=sentinel-ai@edca.local
MAIL_TO=soc@edca.local
MAILPIT_UI_PORT=8025
