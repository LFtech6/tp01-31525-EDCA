<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_extract_events</name>
    <description>Extrai acessos (CSV) e sensores (API REST), limpa, valida e carrega a tabela event; rejeições em dq_rejection</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>RUN_ID</name>
        <default_value>manual</default_value>
        <description>Identificador da execução (passado pelo Job)</description>
      </parameter>
    </parameters>
    <log>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/19 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/19 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>ACESSOS (CSV): limpeza, Regex, validação, lookup porta→zona, conversão de datas</note>
      <xloc>40</xloc>
      <yloc>60</yloc>
      <width>560</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>SENSORES (API REST /gateway): GET, JSON, normalização, lookup sensor→zona</note>
      <xloc>40</xloc>
      <yloc>410</yloc>
      <width>560</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>REJEIÇÕES → dq_rejection (motivo + registo original)</note>
      <xloc>1300</xloc>
      <yloc>340</yloc>
      <width>380</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>sentinel_pg</name>
    <server>${PG_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${PG_DB}</database>
    <port>${PG_PORT}</port>
    <username>${PG_USER}</username>
    <password>${PG_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>EXTRA_OPTION_POSTGRESQL.stringtype</code>
        <attribute>unspecified</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${PG_PORT}</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Read access CSV</from>
      <to>Trim and uppercase</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trim and uppercase</from>
      <to>Dedup access events</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dedup access events</from>
      <to>Regex user and date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Regex user and date</from>
      <to>Regex ISO separator</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Regex ISO separator</from>
      <to>Map access status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map access status</from>
      <to>Lookup door zone</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup door zone</from>
      <to>Validate access</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate access</from>
      <to>Access valid?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pad user digits</from>
      <to>Build user_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build user_id</from>
      <to>Parse access timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse access timestamp</from>
      <to>Lookup user</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup user</from>
      <to>Run id (access)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (access)</from>
      <to>Select access event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select access event</from>
      <to>Upsert access event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Access valid?</from>
      <to>Pad user digits</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trigger</from>
      <to>Set content type</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Set content type</from>
      <to>GET sensor gateway</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>GET sensor gateway</from>
      <to>Parse sensor JSON</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse sensor JSON</from>
      <to>Trim and normalize case</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trim and normalize case</from>
      <to>Dedup sensor events</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dedup sensor events</from>
      <to>Regex ISO timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Regex ISO timestamp</from>
      <to>Map detection value</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map detection value</from>
      <to>Only detections</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Only detections</from>
      <to>Lookup sensor zone</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sensor zone</from>
      <to>Validate sensor</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate sensor</from>
      <to>Sensor valid?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Set sensor source</from>
      <to>Parse sensor timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse sensor timestamp</from>
      <to>Run id (sensor)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (sensor)</from>
      <to>Select sensor event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select sensor event</from>
      <to>Upsert sensor event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sensor valid?</from>
      <to>Set sensor source</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Access rejection</from>
      <to>Map access rejection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map access rejection</from>
      <to>Run id (rejection)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Access bad timestamp</from>
      <to>Map access bad timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map access bad timestamp</from>
      <to>Run id (rejection)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sensor rejection</from>
      <to>Map sensor rejection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map sensor rejection</from>
      <to>Run id (rejection)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sensor bad timestamp</from>
      <to>Map sensor bad timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Map sensor bad timestamp</from>
      <to>Run id (rejection)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (rejection)</from>
      <to>Write rejections</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Access valid?</from>
      <to>Access rejection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sensor valid?</from>
      <to>Sensor rejection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse access timestamp</from>
      <to>Access bad timestamp</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse sensor timestamp</from>
      <to>Sensor bad timestamp</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Clear previous rejections</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>DELETE FROM dq_rejection WHERE run_id = '${RUN_ID}' AND source IN ('ACCESS_CSV','SENSOR_API')</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1460</xloc>
      <yloc>300</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read access CSV</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${SENTINEL_DATA}/raw/access_logs.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>event_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>timestamp</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>user_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>door_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>zone_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>access_status</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Trim and uppercase</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>event_id</in_stream_name>
        <out_stream_name>ev_id</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char></pad_char>
        <pad_len></pad_len>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>timestamp</in_stream_name>
        <out_stream_name>ts_txt</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char></pad_char>
        <pad_len></pad_len>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>user_id</in_stream_name>
        <out_stream_name>user_txt</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char></pad_char>
        <pad_len></pad_len>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>door_id</in_stream_name>
        <out_stream_name>door</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char></pad_char>
        <pad_len></pad_len>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>access_status</in_stream_name>
        <out_stream_name>status_txt</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char></pad_char>
        <pad_len></pad_len>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>200</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Dedup access events</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>N</store_values>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>ev_id</name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Regex user and date</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>user_txt</in_stream_name>
        <out_stream_name>user_digits</out_stream_name>
        <use_regex>yes</use_regex>
        <replace_string>[^0-9]</replace_string>
        <replace_by_string></replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>yes</case_sensitive>
      </field>
      <field>
        <in_stream_name>ts_txt</in_stream_name>
        <out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>^(\d{2})/(\d{2})/(\d{4})</replace_string>
        <replace_by_string>$3-$2-$1</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>yes</case_sensitive>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>480</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Regex ISO separator</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>ts_txt</in_stream_name>
        <out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>^(\d{4}-\d{2}-\d{2})T</replace_string>
        <replace_by_string>$1 </replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>yes</case_sensitive>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>620</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Map access status</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>status_txt</field_to_use>
    <target_field>event_type</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>GRANTED</source_value>
        <target_value>ACCESS_GRANTED</target_value>
      </field>
      <field>
        <source_value>DENIED</source_value>
        <target_value>ACCESS_DENIED</target_value>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>760</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Lookup door zone</name>
