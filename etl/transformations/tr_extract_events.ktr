    <formula>
      <field_name>reject_reason</field_name>
      <formula_string>ts_txt == null ? "MISSING_TIMESTAMP" : user_digits == null || user_digits.length() == 0 ? "MISSING_USER" : door_zone == null || !"DOOR".equals(door_kind) ? "UNKNOWN_DEVICE" : event_type == null ? "INVALID_STATUS" : null</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
