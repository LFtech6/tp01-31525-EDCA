<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_correlate_rules</name>
    <description>Enriquece eventos (horários, permissões), correlaciona-os em casos por zona e proximidade temporal e aplica o motor de regras</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>RUN_ID</name>
        <default_value>manual</default_value>
        <description>Identificador da execução (passado pelo Job)</description>
      </parameter>
    </parameters>
    <log>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>Y</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/19 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/19 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>1. ENRIQUECIMENTO: horário da zona, horário do utilizador, permissões, utilizador inativo</note>
      <xloc>40</xloc>
      <yloc>60</yloc>
      <width>640</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>2. CORRELAÇÃO: casos por zona; novo caso se gap &gt; ${CORRELATION_GAP_MIN} min ou duração &gt; ${CORRELATION_MAX_SPAN_MIN} min</note>
      <xloc>40</xloc>
      <yloc>230</yloc>
      <width>760</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>3. CASOS + RASTREABILIDADE (case_event)        4. MOTOR DE REGRAS (abordagem A)</note>
      <xloc>40</xloc>
      <yloc>400</yloc>
      <width>760</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>sentinel_pg</name>
    <server>${PG_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${PG_DB}</database>
    <port>${PG_PORT}</port>
    <username>${PG_USER}</username>
    <password>${PG_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>EXTRA_OPTION_POSTGRESQL.stringtype</code>
        <attribute>unspecified</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${PG_PORT}</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Read zones</from>
      <to>Lookup zone hours</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read users</from>
      <to>Lookup user profile</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read events</from>
      <to>Lookup zone hours</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup zone hours</from>
      <to>Lookup user profile</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup user profile</from>
      <to>Lookup permission</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup permission</from>
      <to>Minutes of day</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Minutes of day</from>
      <to>Compute flags</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compute flags</from>
      <to>Update event flags</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Update event flags</from>
      <to>Sort by zone and time</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort by zone and time</from>
      <to>Assign case (sessionization)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Assign case (sessionization)</from>
      <to>Per-event indicators</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Per-event indicators</from>
      <to>Aggregate per case</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Aggregate per case</from>
      <to>Build case id and hash</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build case id and hash</from>
      <to>Run id (cases)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (cases)</from>
      <to>Write cases</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Assign case (sessionization)</from>
      <to>Lookup case id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build case id and hash</from>
      <to>Lookup case id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup case id</from>
      <to>Select case_event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select case_event</from>
      <to>Wait for cases</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for cases</from>
      <to>Write case_event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write cases</from>
      <to>Evaluate rules</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Evaluate rules</from>
      <to>Score and classify</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Score and classify</from>
      <to>Risk level</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Risk level</from>
      <to>Write rule results</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Rebuild cases</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>TRUNCATE security_case CASCADE</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>780</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read events</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT event_id, source, event_ts, event_type, zone_id, user_id FROM event</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read zones</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT zone_id, security_level, open_time, close_time, open_weekends FROM zone</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>210</xloc>
      <yloc>70</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read users</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT user_id, role, schedule_start, schedule_end, active FROM app_user</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>70</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Lookup zone hours</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Read zones</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>N</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>zone_id</name>
        <field>zone_id</field>
      </key>
      <value>
        <name>open_time</name>
        <rename>open_time</rename>
        <default/>
        <type>Date</type>
      </value>
      <value>
        <name>close_time</name>
        <rename>close_time</rename>
        <default/>
        <type>Date</type>
      </value>
      <value>
        <name>open_weekends</name>
        <rename>open_weekends</rename>
        <default/>
        <type>Boolean</type>
      </value>
      <value>
        <name>security_level</name>
        <rename>security_level</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>210</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Lookup user profile</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Read users</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>N</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>user_id</name>
        <field>user_id</field>
      </key>
      <value>
        <name>schedule_start</name>
        <rename>schedule_start</rename>
        <default/>
        <type>Date</type>
      </value>
      <value>
        <name>schedule_end</name>
        <rename>schedule_end</rename>
        <default/>
        <type>Date</type>
      </value>
      <value>
        <name>active</name>
        <rename>user_active</rename>
        <default/>
        <type>Boolean</type>
      </value>
      <value>
        <name>role</name>
        <rename>role</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Lookup permission</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>user_zone_permission</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>user_id</name>
        <field>user_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>zone_id</name>
        <field>zone_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>zone_id</name>
        <rename>perm_zone</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>510</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Minutes of day</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>ev_min</field_name>
      <formula_string>(event_ts.getHours() * 60 + event_ts.getMinutes())</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>open_min</field_name>
      <formula_string>(open_time.getHours() * 60 + open_time.getMinutes())</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>close_min</field_name>
      <formula_string>(close_time.getHours() * 60 + close_time.getMinutes())</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>sched_start_min</field_name>
      <formula_string>schedule_start == null ? null : Integer.valueOf((schedule_start.getHours() * 60 + schedule_start.getMinutes()))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>sched_end_min</field_name>
      <formula_string>schedule_end == null ? null : Integer.valueOf((schedule_end.getHours() * 60 + schedule_end.getMinutes()))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_weekend</field_name>
      <formula_string>event_ts.getDay() == 0 || event_ts.getDay() == 6</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>660</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Compute flags</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>is_off_hours</field_name>
      <formula_string>!(open_min &lt;= close_min ? (ev_min &gt;= open_min &amp;&amp; ev_min &lt;= close_min) : (ev_min &gt;= open_min || ev_min &lt;= close_min)) || (is_weekend.booleanValue() &amp;&amp; !open_weekends.booleanValue())</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_outside_schedule</field_name>
      <formula_string>sched_start_min == null ? Boolean.FALSE : Boolean.valueOf(!(sched_start_min.intValue() &lt;= sched_end_min.intValue() ? (ev_min.intValue() &gt;= sched_start_min.intValue() &amp;&amp; ev_min.intValue() &lt;= sched_end_min.intValue()) : (ev_min.intValue() &gt;= sched_start_min.intValue() || ev_min.intValue() &lt;= sched_end_min.intValue())))</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_unauthorized_zone</field_name>
      <formula_string>"ACCESS".equals(source) &amp;&amp; user_id != null &amp;&amp; perm_zone == null</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_unknown_user</field_name>
      <formula_string>"ACCESS".equals(source) &amp;&amp; user_id == null</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_inactive_user</field_name>
      <formula_string>user_active != null &amp;&amp; !user_active.booleanValue()</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>810</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Update event flags</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>event</table>
      <key>
        <name>event_id</name>
        <field>event_id</field>
        <condition>=</condition>
