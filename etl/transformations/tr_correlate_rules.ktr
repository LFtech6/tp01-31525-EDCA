    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>r1</field_name>
      <formula_string>first_denied_ts != null &amp;&amp; last_presence_ts != null &amp;&amp; last_presence_ts.after(first_denied_ts) ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>r2</field_name>
      <formula_string>access_off_hours_count.longValue() &gt;= 1 ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>r3</field_name>
      <formula_string>denied_count.longValue() &gt;= 3 ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>r4</field_name>
      <formula_string>unauthorized_count.longValue() &gt;= 1 ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>630</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Score and classify</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>rule_score</field_name>
      <formula_string>r1.intValue() * 3 + r2.intValue() * 1 + r3.intValue() * 3 + r4.intValue() * 3</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>matched_rules</field_name>
      <formula_string>((r1.intValue() == 1 ? "R1," : "") + (r2.intValue() == 1 ? "R2," : "") + (r3.intValue() == 1 ? "R3," : "") + (r4.intValue() == 1 ? "R4," : "")).replaceAll(",$", "")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>510</xloc>
      <yloc>630</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Risk level</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>is_suspicious</field_name>
      <formula_string>rule_score.intValue() &gt;= 1</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>risk_level</field_name>
      <formula_string>rule_score.intValue() &gt;= 6 ? "CRITICAL" : rule_score.intValue() &gt;= 3 ? "HIGH" : rule_score.intValue() &gt;= 2 ? "MEDIUM" : rule_score.intValue() &gt;= 1 ? "LOW" : "NONE"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>660</xloc>
      <yloc>630</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Write rule results</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <schema/>
    <table>rule_result</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>case_id</column_name>
        <stream_name>case_id</stream_name>
      </field>
      <field>
        <column_name>run_id</column_name>
        <stream_name>run_id</stream_name>
      </field>
      <field>
        <column_name>is_suspicious</column_name>
        <stream_name>is_suspicious</stream_name>
      </field>
      <field>
        <column_name>risk_level</column_name>
        <stream_name>risk_level</stream_name>
      </field>
      <field>
        <column_name>matched_rules</column_name>
        <stream_name>matched_rules</stream_name>
      </field>
      <field>
        <column_name>rule_score</column_name>
        <stream_name>rule_score</stream_name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
