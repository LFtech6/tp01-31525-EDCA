  <step>
    <name>Assign case (sessionization)</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Correlation</jsScript_name>
        <jsScript_script>// Sessionização: novo caso quando muda a zona, o intervalo excede o gap
// ou o caso excede a duração máxima (evita cadeias falsas A-B-C).
var t = event_ts.getTime();
var z = String(zone_id);
if (pzone === null || z !== pzone || (t - plast) &gt; gapMs || (t - cstart) &gt; spanMs) {
  seq++; cstart = t; pos = 0;
}
pos++; pzone = z; plast = t;
var case_seq = seq;
var seq_in_case = pos;</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start</jsScript_name>
        <jsScript_script>// Estado partilhado entre linhas (executado uma vez)
var seq = 0, pzone = null, plast = 0, cstart = 0, pos = 0;
var gapMs  = parseInt(getVariable("CORRELATION_GAP_MIN", "5"), 10) * 60000;
var spanMs = parseInt(getVariable("CORRELATION_MAX_SPAN_MIN", "20"), 10) * 60000;</jsScript_script>
      </jsScript>
    </jsScripts>
