<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_export_incidents</name>
    <description>Exporta os incidentes (casos marcados pelas regras e/ou pela IA) para JSON e CSV, com evidências e explicação</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>RUN_ID</name>
        <default_value>manual</default_value>
        <description>Identificador da execução (passado pelo Job)</description>
      </parameter>
    </parameters>
    <log>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/19 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/19 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Incidente = caso marcado como suspeito pelas regras e/ou pela IA. Rastreabilidade: event_ids (todos) e evidence_event_ids (citados pela IA)</note>
      <xloc>40</xloc>
      <yloc>40</yloc>
      <width>820</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>sentinel_pg</name>
    <server>${PG_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${PG_DB}</database>
    <port>${PG_PORT}</port>
    <username>${PG_USER}</username>
    <password>${PG_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>EXTRA_OPTION_POSTGRESQL.stringtype</code>
        <attribute>unspecified</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${PG_PORT}</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Read incidents</from>
      <to>Who detected</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Who detected</from>
      <to>Run id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id</from>
      <to>Select export fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select export fields</from>
      <to>Export incidents.json</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select export fields</from>
      <to>Export incidents.csv</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Read incidents</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT c.case_id, c.zone_id, z.name AS zone_name, z.security_level,
       to_char(c.start_ts, 'YYYY-MM-DD"T"HH24:MI:SS') AS start_ts, to_char(c.end_ts, 'YYYY-MM-DD"T"HH24:MI:SS') AS end_ts,
       c.event_count, c.event_ids,
       r.is_suspicious AS rules_suspicious, r.risk_level AS rules_risk, r.matched_rules,
       a.status AS ai_status, a.is_suspicious AS ai_suspicious, a.risk_level AS ai_risk, a.incident_type,
       a.explanation, a.recommended_action, a.evidence_event_ids, a.model_name, a.model_digest
FROM security_case c
JOIN zone z USING (zone_id)
JOIN rule_result r USING (case_id)
LEFT JOIN LATERAL (SELECT * FROM ai_analysis x
                   WHERE x.events_hash = c.events_hash AND x.prompt_version = '${PROMPT_VERSION}' AND x.status = 'OK'
                   ORDER BY x.analyzed_at DESC LIMIT 1) a ON true
WHERE r.is_suspicious OR coalesce(a.is_suspicious, false)
ORDER BY c.start_ts</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Who detected</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>detected_by</field_name>
      <formula_string>rules_suspicious.booleanValue() &amp;&amp; ai_suspicious != null &amp;&amp; ai_suspicious.booleanValue() ? "BOTH" : rules_suspicious.booleanValue() ? "RULES_ONLY" : "AI_ONLY"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>230</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
