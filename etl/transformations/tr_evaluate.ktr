<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_evaluate</name>
    <description>Compara o motor de regras (A) e a IA (B) com o ground truth definido à priori: matriz de confusão, precisão, recall, F1</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>RUN_ID</name>
        <default_value>manual</default_value>
        <description>Identificador da execução (passado pelo Job)</description>
      </parameter>
    </parameters>
    <log>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/19 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/19 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Ground truth (CSV, por evento) → etiqueta por caso: suspeito se contiver algum evento de cenário suspeito</note>
      <xloc>40</xloc>
      <yloc>40</yloc>
      <width>700</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>Casos não enviados à IA = negativos da abordagem B (a triagem faz parte do método); falhas da IA contadas à parte</note>
      <xloc>40</xloc>
      <yloc>520</yloc>
      <width>780</width>
      <heigth>30</heigth>
      <fontname>Helvetica</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>sentinel_pg</name>
    <server>${PG_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${PG_DB}</database>
    <port>${PG_PORT}</port>
    <username>${PG_USER}</username>
    <password>${PG_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>EXTRA_OPTION_POSTGRESQL.stringtype</code>
        <attribute>unspecified</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${PG_PORT}</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Read ground truth CSV</from>
      <to>Load ground_truth table</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Load ground_truth table</from>
      <to>Sort GT by event</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort GT by event</from>
      <to>Join events with GT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join events with GT</from>
      <to>Expected flag</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected flag</from>
      <to>Sort by case</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort by case</from>
      <to>Label per case</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read case_event</from>
      <to>Join events with GT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Label per case</from>
      <to>Join labels with results</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read approach results</from>
      <to>Join labels with results</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join labels with results</from>
      <to>Classify outcomes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classify outcomes</from>
      <to>Select comparison</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select comparison</from>
      <to>Export case_comparison.csv</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classify outcomes</from>
      <to>Outcome RULES</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Outcome RULES</from>
      <to>Select RULES</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select RULES</from>
      <to>Sort by approach</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classify outcomes</from>
      <to>Outcome AI</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Outcome AI</from>
      <to>Select AI</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select AI</from>
      <to>Sort by approach</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classify outcomes</from>
      <to>Outcome RULES_AI_SUBSET</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Outcome RULES_AI_SUBSET</from>
      <to>Select RULES_AI_SUBSET</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select RULES_AI_SUBSET</from>
      <to>Sort by approach</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classify outcomes</from>
      <to>Outcome AI_AI_SUBSET</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Outcome AI_AI_SUBSET</from>
      <to>Select AI_AI_SUBSET</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select AI_AI_SUBSET</from>
      <to>Sort by approach</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort by approach</from>
      <to>Confusion matrix</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Confusion matrix</from>
      <to>Precision recall F1</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Precision recall F1</from>
      <to>Run id (metrics)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (metrics)</from>
      <to>Select metrics</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select metrics</from>
      <to>Upsert evaluation_metric</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Upsert evaluation_metric</from>
      <to>Export metrics.csv</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Read ground truth CSV</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${SENTINEL_DATA}/test_scenarios/ground_truth.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>event_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>scenario_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>expected_suspicious</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>rationale</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Load ground_truth table</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <schema/>
    <table>ground_truth</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>event_id</column_name>
        <stream_name>event_id</stream_name>
      </field>
      <field>
        <column_name>scenario_id</column_name>
        <stream_name>scenario_id</stream_name>
      </field>
      <field>
        <column_name>expected_suspicious</column_name>
        <stream_name>expected_suspicious</stream_name>
      </field>
      <field>
        <column_name>rationale</column_name>
        <stream_name>rationale</stream_name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>220</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Sort GT by event</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>event_id</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>380</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read case_event</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT event_id, case_id FROM case_event ORDER BY event_id COLLATE "C"</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>380</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Join events with GT</name>
    <type>MergeJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <join_type>INNER</join_type>
    <step1>Sort GT by event</step1>
    <step2>Read case_event</step2>
    <keys_1>
      <key>event_id</key>
    </keys_1>
    <keys_2>
      <key>event_id</key>
    </keys_2>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>540</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Expected flag</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>exp_i</field_name>
      <formula_string>"true".equalsIgnoreCase(expected_suspicious) ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>700</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Sort by case</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>case_id</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>860</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Label per case</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
      <all_rows>N</all_rows>
      <ignore_aggregate>N</ignore_aggregate>
      <field_ignore/>
      <directory>%%java.io.tmpdir%%</directory>
      <prefix>grp</prefix>
      <add_linenr>N</add_linenr>
      <linenr_fieldname/>
      <give_back_row>N</give_back_row>
      <group>
        <field>
          <name>case_id</name>
        </field>
      </group>
      <fields>
        <field>
          <aggregate>expected</aggregate>
          <subject>exp_i</subject>
          <type>MAX</type>
          <valuefield/>
        </field>
        <field>
          <aggregate>scenario</aggregate>
          <subject>scenario_id</subject>
          <type>MAX</type>
          <valuefield/>
        </field>
      </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1020</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read approach results</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>SELECT c.case_id, r.is_suspicious AS rules_suspicious, r.risk_level AS rules_risk, r.matched_rules,
       a.status AS ai_status, a.is_suspicious AS ai_suspicious, a.risk_level AS ai_risk,
       a.incident_type AS ai_incident_type, a.latency_ms, a.selection_reason
FROM security_case c
JOIN rule_result r USING (case_id)
LEFT JOIN LATERAL (SELECT * FROM ai_analysis x
                   WHERE x.events_hash = c.events_hash AND x.prompt_version = '${PROMPT_VERSION}'
                   ORDER BY (x.status = 'OK') DESC, x.analyzed_at DESC LIMIT 1) a ON true
ORDER BY c.case_id COLLATE "C"
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1020</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Join labels with results</name>
    <type>MergeJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <join_type>INNER</join_type>
    <step1>Label per case</step1>
    <step2>Read approach results</step2>
    <keys_1>
      <key>case_id</key>
    </keys_1>
    <keys_2>
      <key>case_id</key>
    </keys_2>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1180</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Classify outcomes</name>
    <type>Janino</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>ai_sent</field_name>
      <formula_string>ai_status != null</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>ai_failed</field_name>
      <formula_string>ai_status != null &amp;&amp; !"OK".equals(ai_status)</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>rules_outcome</field_name>
      <formula_string>(expected.longValue() == 1) ? ((rules_suspicious.booleanValue()) ? "TP" : "FN") : ((rules_suspicious.booleanValue()) ? "FP" : "TN")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>ai_outcome</field_name>
      <formula_string>ai_status != null &amp;&amp; !"OK".equals(ai_status) ? "FAILED" : (expected.longValue() == 1) ? ((ai_status != null &amp;&amp; ai_suspicious != null &amp;&amp; ai_suspicious.booleanValue()) ? "TP" : "FN") : ((ai_status != null &amp;&amp; ai_suspicious != null &amp;&amp; ai_suspicious.booleanValue()) ? "FP" : "TN")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
