  <step>
    <name>Precision recall F1</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>precision_val</field_name>
      <formula_string>tp_n.longValue() + fp_n.longValue() == 0 ? null : Double.valueOf((double) tp_n.longValue() / (tp_n.longValue() + fp_n.longValue()))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>recall_val</field_name>
      <formula_string>tp_n.longValue() + fn_n.longValue() == 0 ? null : Double.valueOf((double) tp_n.longValue() / (tp_n.longValue() + fn_n.longValue()))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>f1_val</field_name>
      <formula_string>2 * tp_n.longValue() + fp_n.longValue() + fn_n.longValue() == 0 ? null : Double.valueOf(2.0 * tp_n.longValue() / (2 * tp_n.longValue() + fp_n.longValue() + fn_n.longValue()))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
