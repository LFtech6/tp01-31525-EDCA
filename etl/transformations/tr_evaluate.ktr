      <formula_string>inc.longValue() == 1 &amp;&amp; latency_ms != null ? Long.valueOf(latency_ms.longValue()) : null</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
