    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>status</field_name>
      <formula_string>api_status == null || api_status.longValue() != 200 || ai_status == null ? "MODEL_ERROR" : ai_status</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>error_message</field_name>
      <formula_string>api_status == null || api_status.longValue() != 200 ? "HTTP " + api_status : ai_error</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
