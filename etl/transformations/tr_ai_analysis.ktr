        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Select cases for AI</from>
      <to>Set content type</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Set content type</from>
      <to>POST /ai/analyze</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>POST /ai/analyze</from>
      <to>Parse AI response</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse AI response</from>
      <to>Check HTTP status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check HTTP status</from>
      <to>Run id and prompt version</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id and prompt version</from>
      <to>Select analysis fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select analysis fields</from>
      <to>Write ai_analysis</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>POST /ai/analyze</from>
      <to>API unavailable</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>API unavailable</from>
      <to>Run id (failure)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run id (failure)</from>
      <to>Select failure fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select failure fields</from>
      <to>Write API failures</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Select cases for AI</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sentinel_pg</connection>
    <sql>WITH c AS (
  SELECT sc.*,
         (sc.denied_count + sc.off_hours_count + sc.unauthorized_count + sc.inactive_user_count
          + sc.outside_schedule_count + sc.unknown_user_count) AS signals
  FROM security_case sc
), sel AS (
  SELECT case_id, 'SIGNAL' AS selection_reason FROM c WHERE signals &gt; 0
  UNION ALL
  SELECT case_id, 'CONTROL_SAMPLE' FROM (SELECT case_id FROM c WHERE signals = 0 ORDER BY events_hash LIMIT 5) s
)
SELECT c.case_id, c.events_hash, sel.selection_reason,
  json_build_object(
    'case_id', c.case_id,
    'zone', json_build_object('zone_id', z.zone_id, 'name', z.name, 'security_level', z.security_level,
                              'open_time', to_char(z.open_time, 'HH24:MI'), 'close_time', to_char(z.close_time, 'HH24:MI'),
                              'open_weekends', z.open_weekends),
    'start_ts', c.start_ts,
    'end_ts', c.end_ts,
    'events', (SELECT json_agg(json_build_object(
                   'event_id', e.event_id, 'timestamp', e.event_ts, 'source', e.source,
                   'event_type', e.event_type, 'device_id', e.device_id,
                   'user', CASE WHEN u.user_id IS NULL THEN NULL ELSE json_build_object(
                             'user_id', u.user_id, 'role', u.role,
                             'schedule_start', to_char(u.schedule_start, 'HH24:MI'),
                             'schedule_end', to_char(u.schedule_end, 'HH24:MI'),
                             'active', u.active,
                             'has_permission_for_zone', NOT coalesce(e.is_unauthorized_zone, false)) END,
                   'zone_closed_at_event_time', coalesce(e.is_off_hours, false),
                   'outside_user_schedule', coalesce(e.is_outside_schedule, false))
                 ORDER BY e.event_ts, e.event_id)
               FROM case_event ce JOIN event e USING (event_id) LEFT JOIN app_user u ON u.user_id = e.user_id
               WHERE ce.case_id = c.case_id)
  )::text AS payload
FROM c
JOIN sel USING (case_id)
JOIN zone z ON z.zone_id = c.zone_id
WHERE NOT EXISTS (SELECT 1 FROM ai_analysis a
                  WHERE a.events_hash = c.events_hash AND a.prompt_version = '${PROMPT_VERSION}' AND a.status = 'OK')
ORDER BY c.start_ts</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>130</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
