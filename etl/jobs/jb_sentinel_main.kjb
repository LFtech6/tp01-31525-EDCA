INSERT INTO etl_run_stage (run_id, stage, status) VALUES ('${RUN_ID}', 'EXTRACT', 'RUNNING') ON CONFLICT (run_id, stage) DO UPDATE SET status = 'RUNNING', started_at = now(), finished_at = NULL, message = NULL;</sql>
