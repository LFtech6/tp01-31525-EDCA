<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>jb_sentinel_main</name>
  <description>Orquestração completa do Sentinel-AI: referência → eventos → correlação/regras → IA → avaliação → exportação</description>
  <extended_description/>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/19 12:00:00.000</created_date>
