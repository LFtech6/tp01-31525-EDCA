    <parameter>
      <name>RUN_ID</name>
      <default_value>manual</default_value>
      <description>Identificador único da execução</description>
    </parameter>
    <parameter>
      <name>TRIGGER</name>
      <default_value>cli</default_value>
      <description>Origem: cli | dashboard | schedule</description>
    </parameter>
  </parameters>
  <connection>
