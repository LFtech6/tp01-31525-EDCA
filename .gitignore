# Segredos / configuração local
.env
# KETTLE_HOME local (gerado por scripts/kettle_env.sh: kettle.properties com segredos, cache e preferências do Spoon)
etl/kettle-home/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Pentaho / execução
*.log
results/logs/*
!results/logs/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Modelos e binários pesados (nunca no Git)
*.gguf
*.bin
models/

# SO / IDE
.DS_Store
.idea/
.vscode/

# Fila de eventos simulados pelo dashboard (estado de execução)
data/inbox/

# Ferramenta auxiliar de geração de XML Kettle (não faz parte da entrega)
etl/.builder/
